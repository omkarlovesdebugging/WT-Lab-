
int Input = A0;
int R_LED = 3;

int Buzzer = 2;
// VAL INTEGER
int val;
int MAX = 400;

void setup() {
  Serial.begin(9600);
  pinMode(Input ,INPUT);
  pinMode(R_LED ,OUTPUT);
  pinMode(Buzzer ,OUTPUT);
}

void loop() {
  val = analogRead(A0);
 Serial.println(val);

  if (val >= MAX) {
    digitalWrite(R_LED , HIGH);
    digitalWrite(Buzzer ,HIGH);

    delay(5000);
    Serial.println("GAS LEAKING");
  }
  else {
    digitalWrite(R_LED ,LOW);
    digitalWrite(Buzzer ,LOW);

    Serial.println("NORMAL");
    delay(5000);
  }
}

